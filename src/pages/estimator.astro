---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { productTypes, stages, requirements, priorities, estimate, defaults } from '../lib/estimator';

const selects = [
  { id: 'productType', label: 'What are you building?', options: productTypes, value: defaults.type },
  { id: 'productStage', label: 'Product stage', options: stages, value: defaults.stage },
  { id: 'priority', label: 'Main priority', options: priorities, value: defaults.priority },
];
const initial = estimate(defaults);
const caret = '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>';
---
<Base
  title="Product Scope Estimator — Plan Your App Before You Build | Viktor Sokoliuk"
  description="Free product scope estimator: answer four questions about your app, SaaS or AI product and get a recommended direction, complexity level, technical focus and first milestone."
  breadcrumbs={[{ name: 'Estimator', path: '/estimator/' }]}
  footerLinks={[{ href: '/', label: 'Home' }, { href: '/mvp/', label: 'MVP development' }]}
>
  <section class="wrap hero">
    <p class="eyebrow">Product scope estimator</p>
    <h1 class="h1 hero-h1">Clarify what your product needs <span class="accent">before you build it.</span></h1>
    <p class="lead hero-lead">Answer four questions and get a practical direction: recommended approach, complexity level, likely technical areas and the best first milestone.</p>
  </section>

  <section class="band">
    <div class="wrap tool" data-estimator>
      <form class="card inputs" onsubmit="return false">
        {selects.map((s) => (
          <div class="field">
            <label for={s.id}>{s.label}</label>
            <div class="select-wrap">
              <select id={s.id} data-field={s.id}>
                {s.options.map((o) => <option value={o.value} selected={o.value === s.value}>{o.label}</option>)}
              </select>
              <Fragment set:html={caret} />
            </div>
          </div>
        ))}
        <fieldset class="field reqs">
          <legend>Core requirements</legend>
          <div class="req-grid">
            {requirements.map((r) => (
              <label class="req"><input type="checkbox" value={r.value} data-requirement /> <span>{r.label}</span></label>
            ))}
          </div>
        </fieldset>
      </form>

      <div class="result on-dark" aria-live="polite">
        <div class="result-head">
          <span class="result-k">Recommended direction</span>
          <strong class="result-title" data-result="title">{initial.title}</strong>
        </div>
        <dl class="result-grid">
          <div><dt class="result-k">Complexity</dt><dd data-result="complexity">{initial.complexity}</dd></div>
          <div><dt class="result-k">Best first milestone</dt><dd data-result="milestone">{initial.milestone}</dd></div>
        </dl>
        <div class="result-block">
          <span class="result-k">Suggested technical focus</span>
          <p data-result="stack">{initial.stack}</p>
        </div>
        <div class="result-block">
          <span class="result-k">Strategic note</span>
          <p data-result="note">{initial.note}</p>
        </div>
        <Button href="/contact/" variant="inverse">Discuss this direction</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 80px; padding-bottom: 64px; display: flex; flex-direction: column; gap: 28px; }
  .hero-h1 { max-width: 58rem; }
  .hero-lead { max-width: 40rem; }

  .tool {
    padding-top: 72px;
    padding-bottom: 96px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 24px;
    align-items: start;
  }

  .inputs { padding: 28px; display: flex; flex-direction: column; gap: 24px; }
  .field { display: flex; flex-direction: column; gap: 8px; border: 0; margin: 0; padding: 0; min-width: 0; }
  .field label, .field legend { font-size: 14px; font-weight: 600; padding: 0; }
  .field legend { margin-bottom: 8px; }
  .select-wrap { position: relative; }
  .select-wrap select {
    appearance: none;
    width: 100%;
    min-height: 48px;
    padding: 0 44px 0 14px;
    font: inherit;
    font-size: 16px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--input-border);
    border-radius: var(--radius-btn);
    cursor: pointer;
  }
  .select-wrap select:focus-visible { outline: 2px solid var(--accent); outline-offset: 0; border-color: var(--accent); }
  .select-wrap :global(svg) { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); pointer-events: none; color: var(--muted); }

  .req-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 8px; }
  .req {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-btn);
    font-size: 15px;
    font-weight: 400 !important;
    cursor: pointer;
  }
  .req:has(input:checked) { border-color: var(--ink); background: var(--bg); }
  .req input { width: 18px; height: 18px; margin: 0; accent-color: var(--accent); flex: none; }

  .result {
    position: sticky;
    top: 24px;
    background: var(--ink);
    color: var(--bg);
    border-radius: var(--radius-card);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
  }
  .result-k { display: block; font-family: var(--mono); font-size: 12px; color: var(--on-dark-muted); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 6px; }
  .result-title { display: block; font-size: clamp(26px, 2.6vw, 34px); letter-spacing: -0.02em; line-height: 1.15; }
  .result-grid {
    width: 100%;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 20px;
    padding: 20px 0;
    border-top: 1px solid var(--dark-line);
    border-bottom: 1px solid var(--dark-line);
  }
  .result-grid dd { margin: 0; font-weight: 600; }
  .result-block p { color: var(--on-dark-2); font-size: 15px; }
</style>

<script>
  import { estimate } from '../lib/estimator';

  const root = document.querySelector<HTMLElement>('[data-estimator]');
  if (root) {
    const val = (id: string) => root.querySelector<HTMLSelectElement>(`[data-field="${id}"]`)?.value ?? '';
    const out = (key: string) => root.querySelector<HTMLElement>(`[data-result="${key}"]`);

    const update = () => {
      const reqs = [...root.querySelectorAll<HTMLInputElement>('[data-requirement]:checked')].map((i) => i.value);
      const r = estimate({ type: val('productType'), stage: val('productStage'), priority: val('priority'), reqs });
      for (const [key, text] of Object.entries(r)) {
        const el = out(key);
        if (el) el.textContent = text;
      }
    };

    root.addEventListener('change', update);
    update();
  }
</script>
