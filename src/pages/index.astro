---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MetricGrid from '../components/MetricGrid.astro';
import Faq from '../components/Faq.astro';
import ServiceList from '../components/ServiceList.astro';
import { services } from '../data/services';
import { site, bookingHref } from '../config/site';

const { prices } = site;

const metrics = [
  { value: '3,200', label: 'active Android users, Hebrew learning app' },
  { value: '7.41%', label: 'day-7 download-to-paid on iOS' },
  { value: '4×', label: 'subscription revenue growth in 12 months', accent: true },
  { value: 'Kotlin → Swift', label: 'native SwiftUI port, shipped to the App Store' },
];

const stack = [
  'Kotlin · Jetpack Compose',
  'Swift · SwiftUI',
  'Flutter',
  'WordPress · Astro',
  'RevenueCat · Firebase',
  'AI features in production',
];

const reasons = [
  { t: 'CET+1 time zone', d: 'Overlap with all of Europe and the US East Coast mornings.' },
  { t: 'EU contracts &amp; GDPR', d: 'Estonian company, EU VAT invoices, data processing agreement on request.' },
  { t: 'You own everything', d: 'Code, accounts and store listings sit in your name from day one.' },
  { t: 'Product thinking', d: 'I run paywalls and retention for my own apps — and bring that to yours.' },
];

const steps = [
  { t: '20-minute call', d: 'Your idea, users and deadline. Honest answer on fit.' },
  { t: 'Written scope &amp; fixed quote', d: 'Features, milestones and price on one page.' },
  { t: 'Weekly builds', d: 'A test build on your phone every week, not a demo at the end.' },
  { t: 'Launch &amp; handover', d: 'Store release, analytics, docs. Support plan if you want it.' },
];

const faqs = [
  { q: 'How much does an app cost?', a: `Most MVPs I build land between ${prices.mvpRangeMin} and ${prices.mvpRangeMax}. After a 20-minute call you get a fixed quote in writing, so the number does not move during the build.` },
  { q: 'Native or Flutter?', a: 'Flutter when you need both stores fast on one budget. Native Kotlin and Swift when performance, platform features or long-term polish matter more. I build both and will tell you which fits.' },
  { q: 'Who owns the code?', a: 'You do. The repository, developer accounts and store listings are in your name from the first day.' },
  { q: 'Can you work under our agency brand?', a: 'Yes. White-label work with an NDA, your tools and your process. Your client never needs to know I exist.' },
  { q: 'What happens after launch?', a: 'You can take the code to your own team with full docs, or keep me on a monthly support plan for updates, fixes and new features.' },
];
---
<Base
  title="Viktor Sokoliuk — Mobile App & MVP Developer in the EU"
  description={`Independent developer in ${site.city}, ${site.country}. Android, iOS and Flutter apps for founders, white-label WordPress for agencies, fixed-price MVPs in 6–8 weeks.`}
>
  <section class="wrap hero">
    <div class="hero-copy">
      <p class="eyebrow">Independent developer · {site.city}, {site.country}</p>
      <h1 class="h1">I build and sell my own apps. I'll build yours <span class="accent">the same way.</span></h1>
      <p class="lead hero-lead">Android, iOS and Flutter apps for founders, plus WordPress for agencies. One senior developer from scope to store release — with paying users of my own to prove the process works.</p>
      <div class="btn-row">
        <Button href="/estimator/" arrow>Estimate your project</Button>
        <Button href="#call" variant="secondary">Book a call</Button>
      </div>
    </div>
    <MetricGrid items={metrics} head={{ left: 'my_products.log', right: 'updated Nov 2026' }} />
  </section>

  <section class="band band-alt stack-strip" aria-label="Stack">
    <ul class="wrap stack-list">
      {stack.map((s) => <li>{s}</li>)}
    </ul>
  </section>

  <section id="services" class="wrap services">
    <SectionHeading title="Four ways to work together">
      Fixed scope or a monthly retainer. Invoices from an Estonian company, EU VAT handled.
    </SectionHeading>
    <ServiceList
      items={services}
      hrefs={{ mvp: '/mvp/', cto: '/technical-partner/', agencies: '#call', wordpress: '#call' }}
      ids={{ agencies: 'agencies' }}
    />
  </section>

  <section id="cases" class="wrap cases">
    <h2 class="h2 cases-title">Proof, not promises</h2>
    <div class="case-grid">
      <article class="case case-dark on-dark">
        <span class="case-tag">Own product · EdTech</span>
        <h3 class="case-h">Hebrew learning app: from side project to a subscription business</h3>
        <p class="case-p">Designed, built and marketed solo. Paywall experiments, onboarding and ASO, then a native iOS version.</p>
        <div class="case-stats">
          <div><div class="case-num">3,200</div><div class="case-cap">active users</div></div>
          <div><div class="case-num">4×</div><div class="case-cap">ARR in a year</div></div>
        </div>
        <a href="/cases/hebrew-app/" class="link-strong case-link">Read the case →</a>
      </article>
      <article class="case card">
        <span class="case-tag">Platform port</span>
        <h3 class="case-h">Android to native iOS in SwiftUI</h3>
        <p class="case-p">Compose app rebuilt natively for iOS with shared product logic and StoreKit subscriptions.</p>
        <div class="case-stats"><div><div class="case-num">7.41%</div><div class="case-cap">day-7 download-to-paid</div></div></div>
        <a href="/cases/hebrew-app/" class="link-strong">Read the case →</a>
      </article>
      <article class="case card">
        <span class="case-tag">Own product · Android + iOS</span>
        <h3 class="case-h">Korean Alphabet: Hangul</h3>
        <p class="case-p">Hangul course with Phrase X-Ray breakdowns and stroke-order practice, ported natively to iOS.</p>
        <div class="case-stats"><div><div class="case-num">10K+</div><div class="case-cap">downloads on Google Play</div></div></div>
        <a href="/cases/" class="link-strong">All cases →</a>
      </article>
    </div>
  </section>

  <section class="band">
    <div class="wrap why">
      <div>
        <h2 class="h2 why-title">An EU developer, not an outsourcing chain</h2>
        <p class="text-2 why-lead">You talk to the person who writes the code. Same working hours as Berlin, Helsinki and Amsterdam.</p>
      </div>
      <ul class="why-list">
        {reasons.map((r) => (
          <li><span class="why-t" set:html={r.t} /><span class="why-d">{r.d}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section id="estimate" class="band-dark on-dark">
    <div class="wrap process">
      <h2 class="h2 process-title">How a project runs</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="step-n">{String(i + 1).padStart(2, '0')}</span>
            <span class="step-t" set:html={s.t} />
            <span class="step-d">{s.d}</span>
          </li>
        ))}
      </ol>
      <div class="estimator-cta">
        <div>
          <div class="estimator-cta-t">Not sure about budget yet?</div>
          <div class="estimator-cta-d">The estimator gives a price range for your app in about two minutes.</div>
        </div>
        <Button href="/estimator/" variant="inverse">Open the estimator</Button>
      </div>
    </div>
  </section>

  <section class="wrap faq-section">
    <h2 class="h2">Questions clients ask first</h2>
    <Faq items={faqs} />
  </section>

  <section id="call" class="band band-alt">
    <div class="wrap call">
      <h2 class="h-cta call-title">Tell me what you want to build. You'll get a straight answer within one working day.</h2>
      <div class="btn-row">
        <Button href={bookingHref}>Book a 20-min call</Button>
        <Button href={`mailto:${site.email}`} variant="secondary">{site.email}</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .btn-row { display: flex; flex-wrap: wrap; gap: 12px; }

  .hero {
    padding-top: 88px;
    padding-bottom: 72px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: 56px;
    align-items: end;
  }
  .hero-copy { display: flex; flex-direction: column; gap: 28px; }
  .hero-lead { max-width: 34rem; }

  .stack-strip { border-bottom: 1px solid var(--line); }
  .stack-list {
    list-style: none;
    padding-top: 20px;
    padding-bottom: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 40px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--text-2);
  }

  .services { padding-top: 96px; padding-bottom: 40px; }

  .cases { padding-top: 80px; padding-bottom: 80px; }
  .cases-title { margin-bottom: 40px; }
  .case-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 24px;
  }
  .case { padding: 32px; display: flex; flex-direction: column; gap: 18px; }
  .case-dark { background: var(--ink); color: var(--bg); border-radius: var(--radius-card); }
  .case-tag { font-family: var(--mono); font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .case-h { font-size: 26px; letter-spacing: -0.02em; line-height: 1.2; }
  .case-p { color: var(--text-2); font-size: 16px; }
  .case-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid var(--line-soft);
    font-family: var(--mono);
  }
  .case-num { font-size: 24px; }
  .case-cap { font-size: 12px; color: var(--muted); }
  .case-dark .case-tag, .case-dark .case-cap { color: var(--on-dark-muted); }
  .case-dark .case-p { color: var(--on-dark-2); }
  .case-dark .case-stats { border-top-color: var(--dark-line); }
  .case-dark .case-link { color: var(--bg); }

  .why {
    padding-top: 88px;
    padding-bottom: 88px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 48px;
  }
  .why-title { margin-bottom: 16px; }
  .why-lead { max-width: 30rem; }
  .why-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 32px;
  }
  .why-list li { display: flex; flex-direction: column; gap: 6px; padding-top: 16px; border-top: 1px solid var(--ink); }
  .why-t { font-weight: 600; }
  .why-d { color: var(--text-2); font-size: 15px; }

  .process { padding-top: 88px; padding-bottom: 88px; }
  .process-title { margin-bottom: 48px; }
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 32px;
  }
  .steps li { display: flex; flex-direction: column; gap: 10px; }
  .step-n { font-family: var(--mono); font-size: 13px; color: var(--on-dark-muted); }
  .step-t { font-size: 20px; font-weight: 600; }
  .step-d { color: var(--on-dark-2); font-size: 15px; }
  .estimator-cta {
    margin-top: 56px;
    padding: 28px;
    border: 1px solid var(--dark-line);
    border-radius: var(--radius-card);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .estimator-cta-t { font-size: 20px; font-weight: 600; }
  .estimator-cta-d { color: var(--on-dark-2); font-size: 15px; }

  .faq-section {
    padding-top: 96px;
    padding-bottom: 96px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 48px;
  }

  .call { padding-top: 96px; padding-bottom: 96px; display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .call-title { max-width: 52rem; }
</style>
