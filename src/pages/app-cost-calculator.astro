---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../config/site';
import { abs, personId, faqPage } from '../lib/schema';
import { parse, spec, selected, price, timeline, bestFit, logLines, shortText, examples, eur } from '../lib/estimate';

// Server-render the first example so the page is complete without JS.
const text = examples[0].text;
const detections = parse(text);
const rows = spec(detections);
const sel = selected(rows);
const p = price(sel);
const tl = timeline(sel);
const log = logLines(detections, rows);
const base = site.estimator.base;

const how = [
  { t: 'Real prices, not a guess', d: 'Every feature carries the same price I quote clients. No hidden multipliers.' },
  { t: 'AI-assisted build', d: 'I use AI to write code faster, which is why these prices sit below agency rates.' },
  { t: 'Senior review', d: 'Architecture, payments and store releases are mine — tested on my own apps with paying users.' },
];

const faqs = [
  { q: 'How accurate is this estimate?', a: 'Each feature uses the same price I quote clients, so a typical MVP lands inside the range shown. The final number is fixed in writing after a 20-minute call, once I have seen your screens and integrations.' },
  { q: 'Why is it cheaper than an agency?', a: 'One senior developer instead of account managers and rotating juniors, and AI-assisted coding for the repetitive parts. You pay for the build, not the overhead. Architecture, payments and store releases are still done and reviewed by me.' },
  { q: "What isn't included?", a: 'Store developer accounts (Apple $99 a year, Google $25 once), third-party running costs such as hosting, AI API usage and payment fees, marketing and paid ads, and support after launch, which is a separate monthly plan.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'App Development Cost Calculator',
    url: abs('/app-cost-calculator/'),
    description: 'Describe an app in one sentence and get a feature spec, a price range and a week-by-week timeline based on real per-feature prices.',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript for live editing',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    creator: { '@type': 'Person', '@id': personId, name: site.name },
  },
  faqPage(faqs),
];

const pct = (n: number) => `${((n / tl.span) * 100).toFixed(1)}%`;
---
<Base
  title="App Development Cost Calculator — Get a Price in 30 Seconds"
  description="Describe your app in one sentence and get a feature spec, a price range and a week-by-week timeline in 30 seconds. Real per-feature prices, checked by hand before a fixed quote."
  breadcrumbs={[{ name: 'App cost calculator', path: '/app-cost-calculator/' }]}
  footerLinks={[{ href: '/', label: 'Home' }, { href: '/mvp/', label: 'MVP development' }, { href: '/cases/', label: 'Cases' }]}
  schema={schema}
>
  <div data-calc>
    <section class="wrap hero">
      <p class="eyebrow">AI app cost calculator</p>
      <h1 class="hero-h1">Describe your app in a sentence. <span class="accent">See the price and the plan.</span></h1>
      <p class="lead hero-lead">AI turns your idea into a feature spec, a price range and a week-by-week timeline. Then I check it by hand and send a written fixed quote.</p>

      <div class="idea">
        <label for="idea" class="idea-bar"><span>your_idea.txt</span><span><span data-count>{text.length}</span> chars</span></label>
        <textarea id="idea" rows="3" aria-label="Describe your app in a sentence" placeholder="e.g. A language learning app for iOS and Android with daily streaks, subscriptions and an AI tutor that explains mistakes" data-idea>{text}</textarea>
        <div class="idea-foot">
          <div class="examples">
            <span class="examples-k">Try:</span>
            {examples.map((ex, i) => <button type="button" class="chip" data-example={i}>{ex.label}</button>)}
          </div>
          <button type="button" class="btn btn-primary" data-analyze>
            Estimate my app
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </button>
        </div>
      </div>
    </section>

    <section class="wrap work">
      <div class="left">
        <div class="term" role="log" aria-label="Analysis">
          <div class="term-cmd">$ analyze "<span data-short>{shortText(text)}</span>"</div>
          <div data-log>{log.map((l) => <div><span class="term-arrow">→</span> {l}</div>)}</div>
          <div class="term-ok">✓ spec ready · <span data-on-count>{sel.length}</span> features · edit below</div>
        </div>

        <div class="spec card">
          <div class="spec-head">
            <h2 class="spec-h">Your spec</h2>
            <span class="spec-hint">tap to add or remove</span>
          </div>
          <div class="spec-base">
            <div><div class="spec-base-t">{base.label}</div><div class="spec-base-d">{base.desc}</div></div>
            <span class="price-cell">{eur(base.price)}</span>
          </div>
          {rows.map((r) => (
            <button type="button" class="feat" data-feat={r.id} aria-pressed={r.on ? 'true' : 'false'}>
              <span class="feat-box" aria-hidden="true"></span>
              <span class="feat-main"><span class="feat-label">{r.label}</span><span class="feat-reason" data-reason>{r.reason}</span></span>
              <span class="feat-price">+{eur(r.price)}</span>
            </button>
          ))}
        </div>
      </div>

      <div id="quote" class="right">
        <div class="result on-dark">
          <div aria-live="polite">
            <div class="result-k">Estimated price</div>
            <div class="result-price" data-price>{p.text}</div>
            <div class="result-weeks"><span data-weeks>{tl.text}</span> · fixed after a 20-min call</div>
          </div>
          <div class="gantt">
            <div data-phases>
              {tl.phases.map((ph) => (
                <div class="gantt-row">
                  <span class="gantt-name">{ph.name}</span>
                  <span class="gantt-track"><span class:list={['gantt-bar', { 'is-ai': ph.ai }]} style={`margin-left:${pct(ph.start)};width:${pct(ph.len)}`}></span></span>
                </div>
              ))}
            </div>
            <div class="gantt-axis"><span></span><span class="gantt-axis-r"><span>wk 1</span><span>wk <span data-weeks-max>{tl.weeksMax}</span></span></span></div>
          </div>
          <div class="fit">
            <span class="fit-k">Best fit</span>
            <a href="/mvp/#packages" class="fit-link"><span data-pkg>{bestFit(sel)}</span> package →</a>
          </div>
        </div>

        <LeadForm
          id="quote-form"
          subject="Estimate request"
          fields="email"
          compact
          hidden={{ idea: text, features: rows.filter((r) => r.on).map((r) => r.label).join(', '), estimate: p.text, weeks: tl.text }}
        >
          <Fragment slot="intro">
            <h2 class="quote-h">Get it as a written fixed quote</h2>
            <p class="quote-p">Your spec is attached. I reply within one working day.</p>
          </Fragment>
          <Fragment slot="label">Send me the quote</Fragment>
          <p slot="note" class="quote-note">AI drafts the estimate. A human — me — checks every quote before it reaches you.</p>
        </LeadForm>
      </div>
    </section>
  </div>

  <section class="band">
    <div class="wrap how">
      <h2 class="how-h">How the number is made</h2>
      {how.map((x) => <div class="how-item"><span class="how-t">{x.t}</span><span class="how-d">{x.d}</span></div>)}
    </div>
  </section>

  <section class="wrap faq-section">
    <h2 class="how-h">Questions about the estimate</h2>
    <Faq items={faqs} />
  </section>
</Base>

<style>
  .hero { padding-top: 64px; padding-bottom: 40px; display: flex; flex-direction: column; gap: 24px; }
  .hero-h1 { max-width: 56rem; font-size: clamp(40px, 5.4vw, 72px); line-height: 1.02; letter-spacing: -0.035em; font-weight: 700; }
  .hero-lead { max-width: 40rem; }

  .idea { margin-top: 8px; background: var(--surface); border: 1px solid var(--ink); border-radius: var(--radius-card); overflow: hidden; }
  .idea:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  .idea-bar { display: flex; justify-content: space-between; gap: 12px; padding: 12px 18px; border-bottom: 1px solid var(--line-soft); font-family: var(--mono); font-size: 12px; color: var(--muted); }
  .idea textarea {
    display: block;
    width: 100%;
    border: 0;
    outline: none;
    resize: vertical;
    padding: 18px;
    font: inherit;
    font-size: 21px;
    line-height: 1.45;
    color: var(--ink);
    background: var(--surface);
  }
  .idea-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 12px 12px 18px; border-top: 1px solid var(--line-soft); background: var(--surface-2); }
  .examples { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .examples-k { font-family: var(--mono); font-size: 12px; color: var(--muted); }
  .chip { min-height: 44px; padding: 0 14px; display: inline-flex; align-items: center; border: 1px solid var(--chip-border); border-radius: 999px; background: none; color: var(--ink); font: inherit; font-size: 14px; cursor: pointer; }

  .work { padding-top: 16px; padding-bottom: 88px; display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }
  .left { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .right { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 20px; scroll-margin-top: 24px; }

  .term { background: var(--ink); color: var(--on-dark-2); border-radius: var(--radius-card); padding: 20px 22px; font-family: var(--mono); font-size: 13px; line-height: 1.8; overflow-wrap: anywhere; }
  .term-cmd { color: var(--on-dark-muted); margin-bottom: 6px; }
  .term-arrow { color: var(--accent-on-dark); }
  .term-ok { color: var(--bg); }

  .spec-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 18px 22px; border-bottom: 1px solid var(--line-soft); }
  .spec-h { font-size: 20px; font-weight: 600; }
  .spec-hint { font-family: var(--mono); font-size: 12px; color: var(--muted); }
  .spec-base { display: flex; justify-content: space-between; gap: 16px; padding: 16px 22px; border-bottom: 1px solid var(--line-soft); }
  .spec-base-t { font-weight: 600; }
  .spec-base-d { font-size: 14px; color: var(--muted); }
  .price-cell { font-family: var(--mono); font-size: 15px; white-space: nowrap; }

  .feat {
    width: 100%;
    min-height: 64px;
    padding: 14px 22px;
    display: flex;
    align-items: center;
    gap: 16px;
    border: 0;
    border-bottom: 1px solid var(--line-soft);
    background: none;
    font: inherit;
    color: var(--muted);
    text-align: left;
    cursor: pointer;
  }
  .feat:last-child { border-bottom: 0; }
  .feat:focus-visible { outline-offset: -2px; }
  .feat-box {
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 5px;
    border: 1.5px solid var(--input-border);
    background: var(--surface);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: #FFFFFF;
  }
  .feat[aria-pressed='true'] { color: var(--ink); }
  .feat[aria-pressed='true'] .feat-box { background: var(--ink); border-color: var(--ink); }
  .feat[aria-pressed='true'] .feat-box::before { content: '✓'; }
  .feat-main { flex: 1 1 auto; min-width: 0; }
  .feat-label { display: block; font-weight: 600; }
  .feat-reason { display: block; font-family: var(--mono); font-size: 12px; color: var(--muted); }
  .feat-price { font-family: var(--mono); font-size: 15px; white-space: nowrap; }

  .result { background: var(--ink); color: var(--bg); border-radius: var(--radius-card); padding: 28px; display: flex; flex-direction: column; gap: 20px; }
  .result-k { font-family: var(--mono); font-size: 12px; color: var(--on-dark-muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .result-price { font-family: var(--mono); font-size: clamp(34px, 3.6vw, 46px); letter-spacing: -0.03em; line-height: 1.1; margin-top: 6px; }
  .result-weeks { font-size: 15px; color: var(--on-dark-2); margin-top: 6px; }
  .gantt { display: flex; flex-direction: column; gap: 10px; padding-top: 18px; border-top: 1px solid var(--dark-line); }
  .gantt [data-phases] { display: flex; flex-direction: column; gap: 10px; }
  .gantt-row, .gantt-axis { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 12px; align-items: center; font-size: 13px; }
  .gantt-name { color: var(--on-dark-2); }
  .gantt-track { display: block; height: 14px; background: var(--bar-track); border-radius: 3px; }
  .gantt-bar { display: block; height: 14px; border-radius: 3px; background: var(--bg); }
  .gantt-bar.is-ai { background: var(--accent-on-dark); }
  .gantt-axis { font-family: var(--mono); font-size: 11px; color: var(--on-dark-muted); }
  .gantt-axis-r { display: flex; justify-content: space-between; }
  .fit { padding-top: 18px; border-top: 1px solid var(--dark-line); display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: 15px; }
  .fit-k { color: var(--on-dark-2); }
  .fit-link, .fit-link:hover { color: var(--bg); font-weight: 600; display: inline-flex; align-items: center; min-height: 44px; }

  .quote-h { font-size: 20px; font-weight: 600; }
  .quote-p { font-size: 14px; color: var(--muted); }
  .quote-note { font-size: 13px; color: var(--muted); }

  .how { padding-top: 80px; padding-bottom: 80px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 32px; }
  .how-h { font-size: clamp(28px, 3vw, 40px); letter-spacing: -0.03em; line-height: 1.1; }
  .how-item { display: flex; flex-direction: column; gap: 8px; padding-top: 14px; border-top: 1px solid var(--ink); }
  .how-t { font-weight: 600; }
  .how-d { color: var(--text-2); font-size: 15px; }

  .faq-section { padding-top: 16px; padding-bottom: 96px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 48px; }
</style>

<script>
  import { parse, spec, selected, price, timeline, bestFit, logLines, shortText, examples, type Overrides, type FeatureId, type Detection } from '../lib/estimate';

  const root = document.querySelector<HTMLElement>('[data-calc]')!;
  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const textarea = $<HTMLTextAreaElement>('[data-idea]');
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  const setHidden = (name: string, value: string) => {
    const el = form?.querySelector<HTMLInputElement>(`input[name="${name}"]`);
    if (el) el.value = value;
  };

  let analyzed = textarea.value;
  let detections: Detection[] = [];
  let overrides: Overrides = {};

  const line = (text: string) => {
    const div = document.createElement('div');
    const arrow = document.createElement('span');
    arrow.className = 'term-arrow';
    arrow.textContent = '→';
    div.append(arrow, ` ${text}`);
    return div;
  };

  function render() {
    const rows = spec(detections, overrides);
    const sel = selected(rows);
    const p = price(sel);
    const tl = timeline(sel);

    $('[data-short]').textContent = shortText(analyzed);
    $('[data-log]').replaceChildren(...logLines(detections, rows).map(line));
    $('[data-on-count]').textContent = String(sel.length);

    for (const r of rows) {
      const btn = $(`[data-feat="${r.id}"]`);
      btn.setAttribute('aria-pressed', String(r.on));
      btn.querySelector('[data-reason]')!.textContent = r.reason;
    }

    $('[data-price]').textContent = p.text;
    $('[data-weeks]').textContent = tl.text;
    $('[data-weeks-max]').textContent = String(tl.weeksMax);
    $('[data-pkg]').textContent = bestFit(sel);

    const pct = (n: number) => `${((n / tl.span) * 100).toFixed(1)}%`;
    const tpl = $('[data-phases]').firstElementChild as HTMLElement;
    $('[data-phases]').replaceChildren(
      ...tl.phases.map((ph) => {
        const row = tpl.cloneNode(true) as HTMLElement;
        row.querySelector('.gantt-name')!.textContent = ph.name;
        const bar = row.querySelector<HTMLElement>('.gantt-bar')!;
        bar.classList.toggle('is-ai', ph.ai);
        bar.style.marginLeft = pct(ph.start);
        bar.style.width = pct(ph.len);
        return row;
      }),
    );

    setHidden('idea', analyzed);
    setHidden('features', rows.filter((r) => r.on).map((r) => r.label).join(', '));
    setHidden('estimate', p.text);
    setHidden('weeks', tl.text);
  }

  async function analyze(text: string) {
    analyzed = text;
    overrides = {};
    detections = await parse(text);
    render();
  }

  textarea.addEventListener('input', () => { $('[data-count]').textContent = String(textarea.value.length); });
  $('[data-analyze]').addEventListener('click', () => analyze(textarea.value));
  root.querySelectorAll<HTMLButtonElement>('[data-example]').forEach((b) =>
    b.addEventListener('click', () => {
      const ex = examples[Number(b.dataset.example)];
      textarea.value = ex.text;
      $('[data-count]').textContent = String(ex.text.length);
      analyze(ex.text);
    }),
  );
  root.querySelectorAll<HTMLButtonElement>('[data-feat]').forEach((b) =>
    b.addEventListener('click', () => {
      const id = b.dataset.feat as FeatureId;
      overrides = { ...overrides, [id]: b.getAttribute('aria-pressed') !== 'true' };
      render();
    }),
  );

  analyze(analyzed);
</script>
